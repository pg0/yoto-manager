# Yoto OAuth - register a PUBLIC client (PKCE) at https://dashboard.yoto.dev.
# There is no backend and no client secret: the SPA runs the PKCE flow itself.
# This value is compiled into the bundle, so it is public by design.
VITE_YOTO_CLIENT_ID=your-client-id

# In the Yoto dashboard, add every origin the app is served from as an
# Allowed Callback URL *with a trailing slash*, e.g.
#   http://127.0.0.1:5173/          (dev)
#   https://yoto.example.com/       (prod)
# Add the same origins as Allowed Logout URLs, and to Allowed Web Origins if
# that field exists - Auth0 gates the token endpoint on it in some setups.

# Optional overrides (defaults shown):
# VITE_YOTO_SCOPES=openid profile user:content:view user:content:manage user:icons:manage family:devices:view offline_access
# VITE_YOTO_AUTH_BASE=https://login.yotoplay.com
# VITE_YOTO_API_BASE=https://api.yotoplay.com
# VITE_YOTO_AUDIENCE=https://api.yotoplay.com
