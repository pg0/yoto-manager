# Yoto OAuth (register at https://dashboard.yoto.dev)
# Default is a PUBLIC client (PKCE) - only the Client ID is required.
# Set YOTO_CLIENT_SECRET only if you registered a CONFIDENTIAL client.
# Register SEPARATE dev and prod clients - refresh tokens are single-use.
YOTO_CLIENT_ID=your-client-id
YOTO_CLIENT_SECRET=
# Must EXACTLY match an Allowed Callback URL in the dashboard.
YOTO_REDIRECT_URI=http://127.0.0.1:8788/auth/callback
YOTO_SCOPES=openid profile user:content:view user:content:manage user:icons:manage family:devices:view offline_access

# Yoto endpoints (override only if they change)
YOTO_AUTH_BASE=https://login.yotoplay.com
YOTO_API_BASE=https://api.yotoplay.com
YOTO_AUDIENCE=https://api.yotoplay.com

# Backend
PORT=8788
# Where the SPA runs in dev; used for the post-login redirect back to the app.
APP_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=change-me-long-random
# Key used to encrypt per-user refresh tokens at rest (32-byte hex = 64 chars)
TOKEN_ENC_KEY=change-me-64-hex-chars-0000000000000000000000000000000000000000

# Token store: 'file' (dev default, writes ./.data/tokens.json) or 'postgres'.
# Leave DATABASE_URL empty for local file store; set it to use Postgres in prod.
# TOKEN_STORE=file
DATA_DIR=./.data
# DATABASE_URL=postgres://user:pass@host:5432/yoto_manager

# ffmpeg (optional, for MP3 format normalization; leave empty to use PATH)
FFMPEG_PATH=
